# Illumio CloudSecure credentials
illumio_client_id     = "your-client-id"
illumio_client_secret = "your-client-secret"

# Azure tenant to onboard
tenant_id   = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
tenant_name = "Production Azure Tenant"

# Subscription IDs to register with CloudSecure
subscription_ids = [
  "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
]

# Access mode
mode = "ReadWrite"

# Optional: Enable NSG and/or Azure Firewall management
enable_nsg_management  = false
enable_azfw_management = false
